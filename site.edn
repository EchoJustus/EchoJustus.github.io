;; EchoJustus.github.io — site configuration for clogem-press.
;;
;; This is the content repo. The generator lives in EchoJustus/clogem-press and
;; is checked out by .github/workflows/publish.yml at a pinned ref; nothing is
;; vendored here and no built HTML is ever committed.
;;
;; Every key below has a documented default in the generator's
;; `config.example.edn` — that file is the schema. Any string-valued key may be
;; either a plain string (same in all languages) or a map keyed by language
;; code; the fallback chain is
;;
;;     requested lang → :i18n :fallback (default [:site-default :en]) → the key itself
;;
;; (:site-default is :langs :default), so there is exactly one rule to learn
;; (DESIGN.md §6.5).

{;; ---------------------------------------------------------------- site ----
 :site {:title       "EchoJustus"          ; a plain string: identical in all
                                           ; five languages. Swap it for a map
                                           ; keyed by language to localize it,
                                           ; the way :description is below.
        :description {:en      "Notes, guides, and posts."
                      :zh-Hans "笔记、指南与文章。"
                      :zh-Hant "筆記、指南與文章。"
                      :ms      "Nota, panduan, dan catatan."
                      :ta      "குறிப்புகள், வழிகாட்டிகள் மற்றும் இடுகைகள்."}
        :url         "https://echojustus.github.io"   ; no trailing slash
        :base        "/"}                             ; a user site is served at the root

 ;; ----------------------------------------------------------- generator ----
 ;; D-14: the AUTHORITATIVE version pin is the `ref:` in publish.yml, because
 ;; the checkout has already happened by the time the generator reads this
 ;; file. What lives here is documentation, plus a compatibility FLOOR:
 ;; `:min-version "0.2.0"` matches the clogem-press 0.2.0 sha (the commit the
 ;; tag v0.2.0 points at) that publish.yml pins. A generator older than the
 ;; floor is a config error: fm-fix, build and doctor all exit 1 and name both
 ;; versions, so nothing is deployed and the previous deployment keeps serving.
 ;; When you bump the `ref:`, raise this floor in the same commit. Write it as
 ;; MAJOR.MINOR.PATCH without a leading `v`.
 ;;
 ;; :repo itself is documentation. Nothing reads it.
 :generator {:repo "EchoJustus/clogem-press" :min-version "0.2.0"}

 ;; --------------------------------------------------------------- langs ----
 :langs {:default  :en
         ;; Per-article default-version order. The bare /pages/xxxxxx/ URL
         ;; serves the first language in this list that the article ACTUALLY
         ;; HAS — not a site-wide default (DESIGN.md §6.3). That is what lets an
         ;; article exist with no English version and still be reachable at its
         ;; identity URL.
         :priority [:en :zh-Hans :zh-Hant :ms :ta]
         :locales
         {:en      {:label "English"       :html-lang "en"      :giscus "en"    :dir :ltr}
          :zh-Hans {:label "简体中文"       :html-lang "zh-Hans" :giscus "zh-CN" :dir :ltr}
          :zh-Hant {:label "繁體中文"       :html-lang "zh-Hant" :giscus "zh-TW" :dir :ltr}
          ;; :giscus for ms/ta MUST be "en". giscus has no locale for either,
          ;; and data-lang is routed into the widget's iframe URL — an
          ;; unroutable value 404s the iframe and no comment widget renders at
          ;; all. The build validates this whenever the key is present, and
          ;; with :comments :provider :giscus every locale must have one
          ;; (DESIGN.md §6.8).
          :ms      {:label "Bahasa Melayu" :html-lang "ms"      :giscus "en"    :dir :ltr}
          :ta      {:label "தமிழ்"          :html-lang "ta"      :giscus "en"    :dir :ltr}}}

 ;; ---------------------------------------------------------------- i18n ----
 :i18n {:strings-dir   "i18n"     ; <lang>.edn, deep-merged over theme defaults
        ;; false → the primary variant lives at the bare /pages/xxxxxx/ and only
        ;; non-primary variants get a /<lang>/ prefix (D-10).
        :prefix-default? false
        :missing-key   :warn
        :category-labels {}
        :show-fallback-notice true
        ;; Once a reader picks a language with the navbar switcher or the
        ;; per-article variant bar, a page at its BARE URL that also exists in
        ;; that language shows a dismissible "also available in <L>" note,
        ;; written in L. :redirect (go straight to the L variant) and :ignore
        ;; (do nothing) are the alternatives; any other value is a config error.
        :preference :banner}

 ;; ------------------------------------------------------------- content ----
 :content {:dir "content"
           :assets-dir "assets"
           ;; Each toggle gates one index page, /categories/, /tags/ or
           ;; /archives/, in all five languages (/<lang>/categories/ and so
           ;; on). It also gates that page's card and links on the home
           ;; pages, and fm-fix's auto-creation of its file in content/@pages/.
           :category true :tag true :archive true
           :category-text "Notes"        ; category for _posts/ with no subfolder
           :extend-frontmatter {}
           :permalink-prefix "/pages/"
           :permalink-length 6
           ;; true → the build (and `fm-fix`) writes missing front matter into
           ;; the source files. That is what puts the permalink INSIDE the file,
           ;; which is what makes `git mv` URL-safe (DESIGN.md §7.2), and it is
           ;; what the publish workflow's normalization step relies on.
           :write-front-matter true
           :permalinks-file "permalinks.edn"}

 ;; --------------------------------------------------------------- theme ----
 :theme {:default-mode :auto          ; :auto | :light | :dark | :read
         :page-style   :card          ; :card | :line
         :sidebar-open true}

 :nav [{:text {:en      "Home"
               :zh-Hans "首页"
               :zh-Hant "首頁"
               :ms      "Laman utama"
               :ta      "முகப்பு"}
        :link "/"}]

 ;; -------------------------------------------------------------- search ----
 ;; Pagefind, run by `build` over the output. Only article and catalogue bodies
 ;; are indexed (homes and index pages are not), and each language with at
 ;; least one indexed page gets its own index. A page searches one index, never
 ;; a merge: its own language's or, while that language has none yet, the
 ;; largest (English here today). Cross-language search is deferred to a later
 ;; generator release. A failed Pagefind fetch or run fails the build, so
 ;; nothing is deployed and the previous deployment keeps serving.
 :search   {:provider :pagefind}

 ;; ------------------------------------------------------------ comments ----
 ;; giscus, backed by this repo's Discussions. The ids come from
 ;; https://giscus.app. Every language variant of an article shares one thread,
 ;; keyed on its bare permalink (/pages/xxxxxx/). `comment: false` in an
 ;; article's front matter (on its primary variant) turns comments off for
 ;; that article. Catalogues, homes and index pages never carry comments.
 :comments {:provider    :giscus
            :repo        "EchoJustus/EchoJustus.github.io"
            :repo-id     "R_kgDOT47Y5Q"
            :category    "Announcements"
            :category-id "DIC_kwDOT47Y5c4DG2Ks"}

 :analytics {:provider :none}

 ;; What the build emits: /sitemap.xml with hreflang alternates; /robots.txt
 ;; naming it; Atom feeds at /feed.xml and /<lang>/feed.xml; and in every
 ;; page's <head> a canonical link and og:locale, plus hreflang and x-default
 ;; alternates on every page except pagination pages (…/page/N/), which are
 ;; self-canonical only. All but og:locale are absolute URLs built on
 ;; :site :url; a blank :url skips them (a warning, not an error).
 :seo {:sitemap true :hreflang true :x-default :primary
       :feeds true}}
